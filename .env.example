# Reference only: the app reads real environment variables. Never commit real values.
# Local dev: leave DATABASE_URL empty to use SQLite ./network.db. postgres:// URLs are normalized automatically.
DATABASE_URL=
# REQUIRED in production. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
ENV=development
# Comma-separated usernames that are platform admins (moderation queue, suspensions). Only settable here, never in the UI.
ADMIN_USERNAMES=
# Image storage: db (production default) | s3 | local (development default)
STORAGE_BACKEND=
UPLOAD_DIR=
UPLOAD_MAX_BYTES=2097152
# Only for STORAGE_BACKEND=s3 (AWS S3 or Cloudflare R2; also `pip install boto3`)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# Solana reads (read-only). Public mainnet RPC is used when both are empty.
HELIUS_API_KEY=
SOLANA_RPC_URL=
CHAIN_TIMEOUT=10
CHAIN_MAX_SIG_PAGES=10
# Community takeover thresholds and re-check interval
CTO_MIN_BACKERS=10
CTO_MIN_PCT=10
CTO_RECHECK_SECONDS=3600
# Rankings snapshot lifetime in seconds
RANKINGS_TTL=300
# Demo data is refused in production unless this is true
SEED_DEMO=
CORS_ORIGINS=
DISABLE_TRACKER=0
TRACK_INTERVAL_SEC=120
ENDORSE_MIN_ACCOUNT_HOURS=0
