# Copy to .env for reference; the app reads real environment variables (no secrets committed).
# Local dev: leave DATABASE_URL empty to use SQLite ./network.db
DATABASE_URL=
# REQUIRED in production (ENV=production refuses to start with the dev default). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# SECRET_KEY is accepted as a fallback name for JWT_SECRET
ENV=development
# Comma-separated extra origins allowed by CORS (same-origin always works)
CORS_ORIGINS=
# Set to 1 to disable the background DexScreener price tracker
DISABLE_TRACKER=0
# Optional: where uploads are stored (ephemeral on Render free tier)
UPLOAD_DIR=
# Optional: minimum account age (hours) before a user may endorse others
ENDORSE_MIN_ACCOUNT_HOURS=0
