{
  "manifest_version": 3,
  "name": "NETWORK \u2014 X Companion",
  "version": "0.3.0",
  "description": "Your NETWORK feed, posts and public crypto context alongside X. Secure X sign-in; no wallet access.",
  "permissions": [
    "sidePanel",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://network-app-65f6.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open NETWORK companion",
    "default_popup": "sidepanel.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/favicon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/favicon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src https://network-app-65f6.onrender.com; object-src 'none'; base-uri 'none'; frame-src 'none'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "logo.svg"
      ],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ]
    }
  ],
  "minimum_chrome_version": "116"
}
